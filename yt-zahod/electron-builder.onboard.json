{
  "appId": "com.ytzahod.onboard",
  "productName": "YouTube-Onboard-Pro",
  "directories": {
    "output": "dist-onboard"
  },
  "files": [
    "onboard-panel/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".",
      "to": "yt-zahod",
      "filter": [
        "account-onboard.mjs",
        "dolphin-api.mjs",
        "google-youtube-login.mjs",
        "totp-website.mjs",
        "onboard-config.example.json",
        "accounts.example.txt"
      ]
    }
  ],
  "win": {
    "target": [{ "target": "portable", "arch": ["x64"] }],
    "artifactName": "YouTube-Onboard-Pro.exe"
  },
  "portable": {
    "artifactName": "YouTube-Onboard-Pro.exe"
  }
}

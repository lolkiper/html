{
  "name": "shorts-inserter",
  "productName": "Shorts Inserter",
  "version": "1.3.0",
  "description": "Batch tool that inserts a Shorts clip into the middle of every source video and optionally blends a full-length overlay. Electron + FFmpeg, no DaVinci Resolve required.",
  "main": "main.js",
  "author": "Shorts Inserter",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shortsinserter.app",
    "productName": "Shorts Inserter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "processor.js",
      "renderer.js",
      "index.html",
      "styles.css"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "files": [
        "!node_modules/ffprobe-static/bin/darwin/**",
        "!node_modules/ffprobe-static/bin/linux/**"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "files": [
        "!node_modules/ffprobe-static/bin/win32/**",
        "!node_modules/ffprobe-static/bin/linux/**"
      ],
      "target": ["dmg"],
      "category": "public.app-category.video"
    },
    "linux": {
      "files": [
        "!node_modules/ffprobe-static/bin/darwin/**",
        "!node_modules/ffprobe-static/bin/win32/**"
      ],
      "target": ["AppImage"],
      "category": "AudioVideo"
    }
  }
}

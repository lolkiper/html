{
  "name": "shorts-inserter",
  "productName": "Shorts Inserter",
  "version": "1.7.10",
  "description": "Batch tool that inserts Shorts, mass-downloads YouTube, and smart-renames videos from nazvaniya.txt.",
  "main": "main.js",
  "author": "Shorts Inserter",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "smoke": "node scripts/smoke-test.js && node scripts/download-smoke-test.js && node scripts/rename-smoke-test.js",
    "smoke:insert": "node scripts/smoke-test.js",
    "smoke:download": "node scripts/download-smoke-test.js",
    "smoke:rename": "node scripts/rename-smoke-test.js",
    "ensure:ytdlp": "node scripts/ensure-ytdlp.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shortsinserter.app",
    "productName": "Shorts Inserter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "processor.js",
      "downloader.js",
      "renamer.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "vendor/yt-dlp/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "vendor/yt-dlp/**"
    ],
    "win": {
      "files": [
        "!node_modules/ffprobe-static/bin/darwin/**",
        "!node_modules/ffprobe-static/bin/linux/**"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "files": [
        "!node_modules/ffprobe-static/bin/win32/**",
        "!node_modules/ffprobe-static/bin/linux/**"
      ],
      "target": ["dmg"],
      "category": "public.app-category.video"
    },
    "linux": {
      "files": [
        "!node_modules/ffprobe-static/bin/darwin/**",
        "!node_modules/ffprobe-static/bin/win32/**"
      ],
      "target": ["AppImage"],
      "category": "AudioVideo"
    }
  }
}

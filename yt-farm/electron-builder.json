{
  "appId": "com.ytzaliver.farm",
  "productName": "YouTube Zaliver",
  "directories": {
    "output": "dist"
  },
  "files": [
    "panel/**/*",
    "mode-presets.mjs",
    "package.json"
  ],
  "extraFiles": [
    { "from": "main.mjs", "to": "." },
    { "from": "youtube-studio.mjs", "to": "." },
    { "from": "mode-presets.mjs", "to": "." },
    { "from": "config.example.json", "to": "." },
    { "from": "videos", "to": "videos", "filter": ["**/*"] }
  ],
  "win": {
    "target": ["portable"],
    "artifactName": "YouTube-Farm-Pro.exe"
  },
  "portable": {
    "artifactName": "YouTube-Farm-Pro.exe"
  },
  "extraMetadata": {
    "main": "panel/main.mjs"
  }
}
